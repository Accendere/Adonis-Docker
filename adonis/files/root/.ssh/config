# Disabling GSSAPI (see git history on this file) didn't fix the boot-time
# stall - DNS and a raw TCP connect to github.com:22 both succeed
# instantly, but the SSH protocol exchange itself never completes, which
# points at a firewall doing deep packet inspection: TCP handshake gets
# through, actual SSH traffic on port 22 gets silently dropped/stalled.
# GitHub publishes a documented workaround for exactly this - SSH over the
# HTTPS port via ssh.github.com:443 - so redirect there instead. Remote
# URLs stay "git@github.com:..." unchanged; this redirect is transparent,
# and the host key GitHub presents on 443 is the same as on 22, so the
# existing known_hosts entries for "github.com" still apply.
Host github.com
	Hostname ssh.github.com
	Port 443
	GSSAPIAuthentication no
	PreferredAuthentications publickey
